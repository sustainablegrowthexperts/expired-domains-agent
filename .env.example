# Required for Ahrefs retrieval in this milestone. Get this from your Ahrefs account.
AHREFS_KEY=

# Key for the free Ahrefs Domain Rating endpoint used by the DR-check stage.
# This is separate from AHREFS_KEY; leave blank to disable the stage.
AHREFS_FREE_DR_CHECK=

# Domains below this Ahrefs Domain Rating are rejected by the DR check.
DR_FLOOR=10

# API failures are retried per domain up to this many attempts, then stored as
# a terminal DR failure so a broken target cannot loop forever.
DR_CHECK_MAX_ATTEMPTS=3

# Automatic deterministic Live checks for DR-passed domains. The stage resolves
# DNS, fetches the landing page, and gates the Wayback stage. Set to 0 to fall
# back to the previous DR-passed Wayback behaviour.
LIVE_CHECK_ENABLED=1
LIVE_CHECK_MAX_ATTEMPTS=3
LIVE_CHECKS_PER_CYCLE=1
LIVE_CHECK_TIMEOUT_SECONDS=10
LIVE_CHECK_MAX_REDIRECTS=10
LIVE_CHECK_MAX_BODY_BYTES=50000

# Automatic free Wayback Machine checks for Live-passed domains. Disabling this
# also removes the Wayback gate from data collection.
WAYBACK_CHECKS_ENABLED=1
WAYBACK_CHECK_MAX_ATTEMPTS=3
WAYBACK_CHECKS_PER_CYCLE=1
WAYBACK_RATE_PER_SEC=1

# Model used only when the deterministic Wayback checks are ambiguous.
WAYBACK_LLM_MODEL=google/gemini-3.5-flash

# Used by the keyword-check stage and the ambiguous Wayback content fallback.
# The niche LLM pass is still stubbed and labels every dictionary miss
# "STUB LLM NICHE".
OPENROUTER_API_KEY=

# Optional LLM overrides.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NICHE_LLM_MODEL=google/gemini-3.5-flash

# Model used to check keyword reusability in batches of ten.
KEYWORD_CHECK_MODEL=google/gemini-2.5-flash-lite

# Optional model for the purchase-evaluation relevance gate. The gate only
# resolves ambiguous name/topic relevance; the score and verdict stay
# deterministic.
EVALUATION_LLM_MODEL=google/gemini-2.5-flash-lite

# Maximum domains the automatic evaluation worker scores per cycle.
EVALUATION_CHECKS_PER_CYCLE=5

# Seconds between automatic pending-niche worker scans.
NICHE_WORKER_INTERVAL_SECONDS=10

# Automatic standard-tier Ahrefs collection for DR-, Live-, and Wayback-passed
# domains. Off by default so `serve` never spends units unexpectedly. Set to 1
# to enable the worker's data-collection stage.
DATA_COLLECTION_ENABLED=0

# Monthly local unit budget. The worker stops before the reserve is touched.
DATA_COLLECTION_MONTHLY_UNITS=800000
DATA_COLLECTION_RESERVE_UNITS=50000

# Estimated units per standard run, used to avoid starting a run that would
# cross the allowance.
DATA_COLLECTION_ESTIMATED_UNITS=3400

# Maximum domains collected per worker cycle.
DATA_COLLECTION_MAX_PER_CYCLE=1
